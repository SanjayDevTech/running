{
  "version": 8,
  "name": "Running dark",
  "metadata": { "note": "Slightly lighter dark style for OpenFreeMap (OpenMapTiles schema). MapTiler uses the same layers." },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "&copy; OpenStreetMap contributors | OpenFreeMap"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#1b1d22" } },
    {
      "id": "landcover-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "farmland"],
      "paint": { "fill-color": "#1d2823", "fill-opacity": 0.8 }
    },
    {
      "id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "sand", "rock"],
      "paint": { "fill-color": "#23231f", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "residential", "suburb", "neighbourhood", "commercial", "industrial", "retail"],
      "paint": { "fill-color": "#202228", "fill-opacity": 0.8 }
    },
    {
      "id": "landuse-green", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "cemetery", "playground", "pitch", "stadium", "school", "university"],
      "paint": { "fill-color": "#1f2a25", "fill-opacity": 0.8 }
    },
    {
      "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#1f2c26", "fill-opacity": 0.85 }
    },
    {
      "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#0f1a26" }
    },
    {
      "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#0f1a26", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 3] }
    },
    {
      "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#25282f", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0.4, 16, 0.9] }
    },
    {
      "id": "path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13,
      "filter": ["in", "class", "path", "track", "pedestrian"],
      "layout": { "line-cap": "round" },
      "paint": {
        "line-color": "#3a3f48",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 18, 2.5],
        "line-dasharray": [2, 1.5]
      }
    },
    {
      "id": "road-minor-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["in", "class", "minor", "service", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#15171b", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.8, 18, 14] }
    },
    {
      "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 12,
      "filter": ["in", "class", "minor", "service", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#30343c", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.4, 18, 11] }
    },
    {
      "id": "road-major-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "trunk", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#15171b", "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 6, 0.8, 18, 22] }
    },
    {
      "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "trunk", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], "motorway", "#4b505c", "trunk", "#464b56", "#3d424c"],
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 6, 0.4, 18, 18]
      }
    },
    {
      "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 11,
      "filter": ["==", "class", "rail"],
      "paint": { "line-color": "#2a2d34", "line-width": 1, "line-dasharray": [3, 3] }
    },
    {
      "id": "boundary", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "maxzoom": 10,
      "filter": ["<=", "admin_level", 4],
      "paint": { "line-color": "#3a3f48", "line-width": 0.8, "line-dasharray": [4, 2] }
    },
    {
      "id": "road-name", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#7d828d", "text-halo-color": "#1b1d22", "text-halo-width": 1.2 }
    },
    {
      "id": "water-name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": { "text-color": "#4f6a86", "text-halo-color": "#0f1a26", "text-halo-width": 1 }
    },
    {
      "id": "place-small", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", "class", "suburb", "neighbourhood", "village", "hamlet"],
      "minzoom": 11,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 16, 14],
        "text-max-width": 8
      },
      "paint": { "text-color": "#8a8f9a", "text-halo-color": "#1b1d22", "text-halo-width": 1.2 }
    },
    {
      "id": "place-large", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 12, 16],
        "text-max-width": 8
      },
      "paint": { "text-color": "#a3a8b3", "text-halo-color": "#1b1d22", "text-halo-width": 1.4 }
    }
  ]
}
