    <string name="onboarding_background_title">Resume after a crash</string>
    <string name="onboarding_background_body">If Android closes the app mid-run, \"Allow all the time\" lets the run resume by itself. Android opens the settings page: pick Location, then Allow all the time. You can skip this and resume manually instead.</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">Shows live distance and time while you run, and lets you pause or stop from the lock screen.</string>
    <string name="onboarding_activity_title">Steps and cadence</string>
    <string name="onboarding_activity_body">Uses the step sensor for cadence and to keep distance going through short GPS gaps.</string>
    <string name="onboarding_battery_title">Battery optimisation</string>
    <string name="onboarding_battery_body">Some phones stop apps in the background to save power. Allow Running to ignore battery optimisation so long runs are not cut short.</string>
